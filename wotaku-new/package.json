    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "copyright:check": "node tools/check-copyright.mjs",
    "copyright:fix": "node tools/check-copyright.mjs --fix",
    "check": "pnpm copyright:check && pnpm knip && pnpm lint && pnpm format:check && pnpm typecheck",
    "bench": "vitest bench --run --config vitest.config.ts",
    "bench:build": "node tools/benchmark-build.mjs"
  },
